{
  "name": "dnssec-oracle-contract",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "DNSSEC oracle contract: proves TXT records on-chain from the DNS root down",
  "scripts": {
    "build": "algokit compile ts smart_contracts --target-avm-version 13 --output-source-map --out-dir artifacts && algokit generate client smart_contracts/artifacts --output {app_spec_dir}/{contract_name}Client.ts",
    "test": "vitest run",
    "test:unit": "vitest run algo.spec",
    "test:e2e": "vitest run e2e.spec",
    "check-types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0"
  },
  "dependencies": {
    "@algorandfoundation/algorand-typescript": "1.3.1",
    "@d13co/puya-ts-utils": "^0.2.0",
    "@d13co/dnssec-oracle-sdk": "link:../dnssec-oracle-sdk"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "^6.0.1",
    "@algorandfoundation/algokit-utils": "^9.2.2",
    "@algorandfoundation/algorand-typescript-testing": "^1.2.0",
    "@algorandfoundation/puya-ts": "1.3.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.0.0",
    "algosdk": "^3.8.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
