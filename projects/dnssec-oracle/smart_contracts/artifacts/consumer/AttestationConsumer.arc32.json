    "state": {
        "global": {
            "num_byte_slices": 0,
            "num_uints": 1
        },
        "local": {
            "num_byte_slices": 0,
            "num_uints": 0
        }
    },
    "schema": {
        "global": {
            "declared": {
                "oracle": {
                    "type": "uint64",
                    "key": "oracle",
                    "descr": "The oracle, pinned at create: an app the caller names could hold forged boxes."
                }
            },
            "reserved": {}
        },
        "local": {
            "declared": {},
            "reserved": {}
        }
    },
    "contract": {
        "name": "AttestationConsumer",
        "desc": "Example consumer: reads the oracle's attestation boxes directly, through the reference reader\n(`hasTxt`), or asks the oracle's `hasRecord` by inner call (`hasTxtByCall`).",
        "methods": [
            {
                "name": "createApplication",
                "args": [
                    {
                        "type": "uint64",
                        "name": "oracle"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                }
            },
            {
                "name": "hasTxt",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "name"
                    },
                    {
                        "type": "byte[]",
                        "name": "text"
                    },
                    {
                        "type": "uint64",
                        "name": "maxAge",
                        "desc": "Oldest acceptable inception, in seconds before now"
                    },
                    {
                        "type": "uint64",
                        "name": "minKeyBits",
                        "desc": "Weakest acceptable key on the chain"
                    },
                    {
                        "type": "byte[][]",
                        "name": "zones",
                        "desc": "The signer's zone up to the TLD (wire format), for the chain walk"
                    }
                ],
                "readonly": true,
                "returns": {
                    "type": "bool"
                },
                "desc": "Whether `name` (wire format) has a usable TXT record holding exactly `text`."
            },
            {
                "name": "hasTxtByCall",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "name"
                    },
                    {
                        "type": "byte[]",
                        "name": "text"
                    },
                    {
                        "type": "uint64",
                        "name": "maxAge"
                    },
                    {
                        "type": "uint64",
                        "name": "minKeyBits"
                    },
                    {
                        "type": "byte[][]",
                        "name": "zones"
                    }
                ],
                "readonly": true,
                "returns": {
                    "type": "bool"
                },
                "desc": "`hasTxt` through the oracle's `hasRecord`, which walks the chain itself. Same box\nreferences, plus one inner call's fee. The pin still matters: an app the caller names\ncould return anything."
            }
        ],
        "networks": {}
    },
    "bare_call_config": {}
}