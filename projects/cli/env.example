# ENV=testnet            # load .env.testnet instead of .env

# LocalNet defaults; for a public network e.g. ALGOD_HOST=testnet-api.4160.nodely.dev ALGOD_PORT=443 ALGOD_TOKEN=
ALGOD_HOST=localhost
ALGOD_PORT=4001
ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

APP_ID=

# Needed by every write command: a 25-word mnemonic, used to sign locally and never sent.
# NEVER a MainNet account's: use a throwaway TestNet/LocalNet account. Keep this file out of git.
MNEMONIC=
# Only for a rekeyed account: the address MNEMONIC signs for
ADDRESS=

DEBUG=false
