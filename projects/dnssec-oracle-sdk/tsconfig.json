{
  "compilerOptions": {
    "declaration": true,
    "target": "ES2022",
    "moduleResolution": "node",
    "module": "CommonJS",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true
  },
  "include": ["src"]
}
